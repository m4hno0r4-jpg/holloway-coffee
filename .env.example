# Copy this file to `.env` (or `.env.local`) and fill in real values.
# `.env` is git-ignored. Never commit it.
#
# Supabase is not used yet. These will be wired up when we add accounts,
# products and orders. Only browser-safe values belong in VITE_ variables:
# anything prefixed with VITE_ is bundled into the public JavaScript.
#
# NEVER put a Supabase `service_role` key (or any other secret) in this project.

# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
